# Public values only. Copy to .env.local and fill in.
# Never put the secret (service_role / sb_secret_) key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only secret (never NEXT_PUBLIC_*). Needed to create a centre (onboarding).
# Create it in Supabase: Project Settings -> API Keys -> Secret keys.
SUPABASE_SECRET_KEY=
